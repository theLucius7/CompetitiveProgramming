{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: 竞赛快速编译 (GNU++23)",
            "command": "/Users/l7/.local/bin/cph-g++-fast",
            "args": [
                "-fdiagnostics-color=always",
                "-std=gnu++23",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-O2",
                "-pipe",
                "-mcpu=native",
                "-mtune=native"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}
